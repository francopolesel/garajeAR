generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String
  locale           String   @default("es")
  currency         String   @default("USD")
  distanceUnit     String   @default("KM")
  volumeUnit       String   @default("L")
  timeZone         String   @default("America/Argentina/Buenos_Aires")
  theme            String   @default("SYSTEM")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vehicles         Vehicle[]
  expenses         Expense[]
  reminders        Reminder[]
  documents        Document[]
  passwordResetTokens PasswordResetToken[]
  sessions         Session[]
  odometerReadings OdometerReading[]
  maintenanceRecords MaintenanceRecord[]
  energyLogs       EnergyLog[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Vehicle {
  id                 String   @id @default(uuid())
  userId             String
  type               String
  name               String
  make               String
  model              String
  modelYear          Int
  trim               String?
  vin                String?
  registrationNumber String?
  engine             String?
  displacement       Float?
  transmission       String?
  powertrain         String?
  bodyStyle          String?
  color              String?
  purchaseDate       DateTime?
  purchasePrice      Decimal? @db.Decimal(14, 2)
  purchaseCurrency   String?
  currentOdometer    Float    @default(0)
  odometerUnit       String   @default("KM")
  photoUrl           String?
  notes              String?
  archived           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  odometerReadings   OdometerReading[]
  maintenanceRecords MaintenanceRecord[]
  energyLogs         EnergyLog[]
  expenses           Expense[]
  reminders          Reminder[]
  documents          Document[]

  @@index([userId])
  @@index([userId, archived])
}

model OdometerReading {
  id        String   @id @default(uuid())
  userId    String
  vehicleId String
  value     Float
  unit      String
  observedAt DateTime
  source    String?
  note      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([vehicleId, observedAt])
}

model MaintenanceRecord {
  id             String   @id @default(uuid())
  userId         String
  vehicleId      String
  category       String
  title          String
  serviceDate    DateTime
  odometer       Float?
  odometerUnit   String?
  workshop       String?
  partsCost      Decimal? @db.Decimal(14, 2)
  laborCost      Decimal? @db.Decimal(14, 2)
  totalCost      Decimal? @db.Decimal(14, 2)
  currency       String?
  partsNotes     String?
  notes          String?
  nextDueDate    DateTime?
  nextDueOdometer Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  expense        Expense? @relation("MaintenanceExpense")

  @@index([userId])
  @@index([vehicleId])
  @@index([serviceDate])
}

model EnergyLog {
  id            String   @id @default(uuid())
  userId        String
  vehicleId     String
  eventType     String
  subtype       String?
  quantity      Float
  quantityUnit  String
  eventDate     DateTime
  odometer      Float?
  odometerUnit  String?
  totalCost     Decimal? @db.Decimal(14, 2)
  currency      String?
  fullTank      Boolean  @default(false)
  station       String?
  chargingType  String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  expense       Expense? @relation("EnergyExpense")

  @@index([userId])
  @@index([vehicleId])
  @@index([eventDate])
}

model Expense {
  id               String   @id @default(uuid())
  userId           String
  vehicleId        String?
  category         String
  title            String
  amount           Decimal  @db.Decimal(14, 2)
  currency         String
  expenseDate      DateTime
  paymentMethod    String?
  odometer         Float?
  notes            String?
  receiptDocumentId String?
  maintenanceRecordId String? @unique
  energyLogId      String? @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle          Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  maintenanceRecord MaintenanceRecord? @relation("MaintenanceExpense", fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  energyLog        EnergyLog? @relation("EnergyExpense", fields: [energyLogId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([expenseDate])
  @@index([category])
}

model Reminder {
  id              String   @id @default(uuid())
  userId          String
  vehicleId       String?
  category        String
  title           String
  description     String?
  dueDate         DateTime?
  dueOdometer     Float?
  dueOdometerUnit String?
  daysBefore      Int      @default(7)
  distanceBefore  Float?
  completedAt     DateTime?
  snoozedUntil    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([dueDate])
}

model Document {
  id           String   @id @default(uuid())
  userId       String
  vehicleId    String
  name         String
  category     String
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  issueDate    DateTime?
  expirationDate DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([expirationDate])
}
