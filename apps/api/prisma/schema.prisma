generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String
  locale           String   @default("es")
  currency         String   @default("USD")
  distanceUnit     String   @default("KM")
  volumeUnit       String   @default("L")
  timeZone         String   @default("America/Argentina/Buenos_Aires")
  theme            String   @default("SYSTEM")
  username         String?  @unique
  displayName      String?
  bio              String?
  avatarUrl        String?
  profileVisibility String  @default("PUBLIC")
  friendRequestPermission String @default("EVERYONE")
  onlineVisibility String   @default("EVERYONE")
  lastSeenVisibility String @default("EVERYONE")
  readReceipts     Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vehicles         Vehicle[]
  expenses         Expense[]
  reminders        Reminder[]
  documents        Document[]
  inspections      Inspection[]
  userIdentities   UserIdentity[]
  exchangeRateSnapshots ExchangeRateSnapshot[]
  sentRequests     FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
  friendshipsA     Friendship[]   @relation("FriendA")
  friendshipsB     Friendship[]   @relation("FriendB")
  blockedByMe      UserBlock[]    @relation("Blocker")
  blockedMe        UserBlock[]    @relation("Blocked")
  conversationMemberships ConversationMember[]
  sentMessages     Message[]      @relation("Sender")
  messageReactions MessageReaction[]
  socialNotifications SocialNotification[]
  abuseReports     AbuseReport[]  @relation("Reporter")
  passwordResetTokens PasswordResetToken[]
  sessions         Session[]
  odometerReadings OdometerReading[]
  maintenanceRecords MaintenanceRecord[]
  energyLogs       EnergyLog[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Vehicle {
  id                 String   @id @default(uuid())
  userId             String
  type               String
  name               String
  make               String
  model              String
  modelYear          Int
  trim               String?
  vin                String?
  registrationNumber String?
  engine             String?
  displacement       Float?
  transmission       String?
  powertrain         String?
  bodyStyle          String?
  color              String?
  purchaseDate       DateTime?
  purchasePrice      Decimal? @db.Decimal(14, 2)
  purchaseCurrency   String?
  currentOdometer    Float    @default(0)
  odometerUnit       String   @default("KM")
  photoUrl           String?
  notes              String?
  archived           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  odometerReadings   OdometerReading[]
  maintenanceRecords MaintenanceRecord[]
  energyLogs         EnergyLog[]
  expenses           Expense[]
  reminders          Reminder[]
  documents          Document[]
  inspections        Inspection[]

  @@index([userId])
  @@index([userId, archived])
}

model OdometerReading {
  id        String   @id @default(uuid())
  userId    String
  vehicleId String
  value     Float
  unit      String
  observedAt DateTime
  source    String?
  note      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([vehicleId, observedAt])
}

model MaintenanceRecord {
  id             String   @id @default(uuid())
  userId         String
  vehicleId      String
  category       String
  title          String
  serviceDate    DateTime
  odometer       Float?
  odometerUnit   String?
  workshop       String?
  partsCost      Decimal? @db.Decimal(14, 2)
  laborCost      Decimal? @db.Decimal(14, 2)
  totalCost      Decimal? @db.Decimal(14, 2)
  currency       String?
  partsNotes     String?
  notes          String?
  nextDueDate    DateTime?
  nextDueOdometer Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  expense        Expense? @relation("MaintenanceExpense")

  @@index([userId])
  @@index([vehicleId])
  @@index([serviceDate])
}

model EnergyLog {
  id            String   @id @default(uuid())
  userId        String
  vehicleId     String
  eventType     String
  subtype       String?
  quantity      Float
  quantityUnit  String
  eventDate     DateTime
  odometer      Float?
  odometerUnit  String?
  totalCost     Decimal? @db.Decimal(14, 2)
  currency      String?
  fullTank      Boolean  @default(false)
  station       String?
  chargingType  String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  expense       Expense? @relation("EnergyExpense")

  @@index([userId])
  @@index([vehicleId])
  @@index([eventDate])
}

model Expense {
  id               String   @id @default(uuid())
  userId           String
  vehicleId        String?
  category         String
  title            String
  amount           Decimal  @db.Decimal(14, 2)
  currency         String
  expenseDate      DateTime
  paymentMethod    String?
  odometer         Float?
  notes            String?
  receiptDocumentId String?
  maintenanceRecordId String? @unique
  energyLogId      String? @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle          Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  maintenanceRecord MaintenanceRecord? @relation("MaintenanceExpense", fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  energyLog        EnergyLog? @relation("EnergyExpense", fields: [energyLogId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([expenseDate])
  @@index([category])
}

model Reminder {
  id              String   @id @default(uuid())
  userId          String
  vehicleId       String?
  category        String
  title           String
  description     String?
  dueDate         DateTime?
  dueOdometer     Float?
  dueOdometerUnit String?
  daysBefore      Int      @default(7)
  distanceBefore  Float?
  completedAt     DateTime?
  snoozedUntil    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([dueDate])
}

model Document {
  id           String   @id @default(uuid())
  userId       String
  vehicleId    String
  name         String
  category     String
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  issueDate    DateTime?
  expirationDate DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([expirationDate])
}

model Inspection {
  id               String   @id @default(uuid())
  userId           String
  vehicleId        String
  inspectionType   String
  country          String?
  jurisdiction     String?
  inspectionDate   DateTime
  expirationDate   DateTime?
  result           String
  certificateNumber String?
  center           String?
  odometer         Float?
  odometerUnit     String?
  cost             Decimal? @db.Decimal(14, 2)
  currency         String?
  reinspectionDeadline DateTime?
  defects          String?
  notes            String?
  documentId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([expirationDate])
}

model UserIdentity {
  id           String   @id @default(uuid())
  userId       String
  provider     String
  providerSub  String
  email        String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSub])
  @@index([userId])
}

model ExchangeRateSnapshot {
  id            String   @id @default(uuid())
  userId        String?
  fromCurrency  String
  toCurrency    String
  rate          Decimal  @db.Decimal(18, 8)
  rateType      String
  provider      String
  quoteDate     DateTime
  retrievedAt   DateTime @default(now())
  manualOverride Boolean @default(false)
  transactionDate DateTime?
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([fromCurrency, toCurrency, quoteDate])
}

model CpiIndex {
  id        String   @id @default(uuid())
  country   String
  series    String
  yearMonth String
  indexValue Decimal @db.Decimal(18, 6)
  source    String
  createdAt DateTime @default(now())

  @@unique([country, series, yearMonth])
  @@index([country, series])
}

model FriendRequest {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  pairKey     String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  decidedAt   DateTime?

  sender      User     @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ReceivedRequests", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([pairKey])
  @@index([status])
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  pairKey   String   @unique
  createdAt DateTime @default(now())

  userA     User     @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)

  @@index([userAId])
  @@index([userBId])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Conversation {
  id        String   @id @default(uuid())
  type      String   @default("DIRECT")
  name      String?
  avatarUrl String?
  creatorId String?
  pairKey   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   ConversationMember[]
  messages  Message[]

  @@index([updatedAt])
}

model ConversationMember {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  role           String   @default("MEMBER")
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?
  lastReadMessageId String?
  muted          Boolean  @default(false)
  archived       Boolean  @default(false)
  pinned         Boolean  @default(false)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  type           String   @default("TEXT")
  text           String?
  replyToId      String?
  clientId       String?
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?     @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("Replies")
  attachments    MessageAttachment[]
  reactions      MessageReaction[]

  @@index([conversationId, createdAt])
  @@unique([conversationId, clientId])
}

model MessageAttachment {
  id          String   @id @default(uuid())
  messageId   String
  storageKey  String
  originalName String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model SocialNotification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AbuseReport {
  id          String   @id @default(uuid())
  reporterId  String
  reportedId  String?
  messageId   String?
  reason      String
  details     String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  reporter    User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reporterId])
}
